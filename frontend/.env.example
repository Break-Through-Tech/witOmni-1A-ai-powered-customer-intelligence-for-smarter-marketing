# Copy to .env.local and fill in. Never commit .env.local (spec 000 NFR-6).
LLM_PROVIDER=google
LLM_MODEL=gemini-flash-lite-latest
# Used automatically when the main model is busy or out of free quota.
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
LLM_API_KEY=
# Optional: max assistant questions per day across all visitors (default 300).
# ASSISTANT_DAILY_CAP=300
